# ---- Backend settings. Copy the lines you need into .env.local (never commit .env.local) ----
# There is NO AI and no API key in this project. Everything below is optional.

# Which frontend origins may call this backend from a browser (CORS). Comma-separated, exact origins, no paths.
# Leave empty if the frontend and backend share one origin. Use * only for a public demo (any website could call your API).
# Example: ALLOWED_ORIGINS=https://your-frontend.example.app,http://localhost:5173
ALLOWED_ORIGINS=

# Requests per minute per client for /api/analyse and /api/extract (default 60)
RATE_LIMIT_PER_MIN=60

# Leave this false unless your host's proxy OVERWRITES X-Forwarded-For (test it first, see README section 10).
# While false, all callers share one rate-limit bucket, which still protects the server.
TRUST_PROXY_HEADERS=false

# Only if the OCR language file is not in node_modules/@tesseract.js-data/eng/4.0.0_best_int
# OCR_LANG_PATH=
